# ===== 云开发环境 =====
# 云开发环境 ID（TCB 控制台「环境」页查看）：lwx1-d3gq2yj54ea9800e4
# 微信小程序 AppID（微信公众平台查看）：wx7d3a99bc0efe1f50

# ===== 数据库 =====
# 本地开发用 SQLite；TCB 部署时换成云数据库 MySQL 连接串（在云开发「数据库」创建 MySQL 实例后获取）
DATABASE_URL=sqlite:///./roundtable.db

# ===== LLM（圆桌分析大脑）=====
# 本地验证先开 mock；TCB 部署填国内 API key 后设 false
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 取数层（行情/财务）=====
# 本地验证先开 mock；TCB 部署用 akshare/tencent_provider 设 false
FETCHER_MOCK=true

# ===== Redis（缓存/限流，TCB 可选）=====
REDIS_URL=

# ===== COS 对象存储（报告 H5，TCB 可选）=====
# 三项都填 → 报告上传 COS 返回 https 链接（容器重建不丢，适合小程序 web-view/分享）
# 留空 → 报告写容器本地 ./reports（容器重建会丢，仅本地验证用）
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# ===== 对外访问基址（报告链接/邮件）=====
BASE_URL=http://localhost:8000

# ===== 邮件兜底（QQ 邮箱连接器）=====
EMAIL_USER=
EMAIL_PASS=
