.page { padding: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.h { font-size: 28rpx; font-weight: 600; color: #c0392b; margin: 16rpx 0 8rpx; }
textarea, input { width: 100%; box-sizing: border-box; border: 1rpx solid #eee; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; font-size: 28rpx; }
button { margin-top: 8rpx; background: #c0392b; color: #fff; }
.types { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tag { padding: 10rpx 24rpx; border-radius: 999rpx; background: #f0f0f0; font-size: 26rpx; color: #666; }
.tag.on { background: #c0392b; color: #fff; }
.loading { text-align: center; color: #999; padding: 80rpx 0; }
.item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.item .t { font-size: 24rpx; color: #c0392b; }
.item .title { font-size: 30rpx; margin: 8rpx 0; }
.item .ts { font-size: 22rpx; color: #bbb; }
.empty { text-align: center; color: #bbb; padding: 80rpx 0; }
